BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
VERBX_API_KEY=
TELEGRAM_BOT_TOKEN=

# fixture = labelled test pages on GitHub Pages, live = the real portal adapter
SOURCE=fixture
FIXTURE_BASE=https://YOUR-USERNAME.github.io/land-record-watch/fixtures
CHECK_HOUR=7

# Development switches. Leave these off for the demo and the submission.
DEV_NO_BROWSER=0
DRY_RUN=0

# Language model for the agent's decision step. Leave empty to use the built-in rules.
# Works with any provider that offers an OpenAI-style /chat/completions endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLED=1
