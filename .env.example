BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
VERBX_API_KEY=
TELEGRAM_BOT_TOKEN=

# fixture = labelled test pages on GitHub Pages, live = the real portal adapter
SOURCE=fixture
FIXTURE_BASE=https://YOUR-USERNAME.github.io/land-record-watch/fixtures
CHECK_HOUR=7

# Development switches. Leave these off for the demo and the submission.
DEV_NO_BROWSER=0
DRY_RUN=0

# Language model for the agent's decision step. Leave empty to use the built-in rules.
# Works with any provider that offers an OpenAI-style /chat/completions endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLED=1
BB_MAX_SESSIONS_PER_DAY=20
# Demo registry (website). SOURCE=portal makes the agent read the registry instead of the test pages.
PORTAL_BASE=
PORTAL_DB=data/portal.db
PORTAL_SECRET_KEY=
PORTAL_HTTPS=0
PORTAL_REGISTRAR_EMAIL=
PORTAL_REGISTRAR_PASSWORD=

# VerbX spending protection (defaults shown). Keep these low so the free credit is never exceeded.
VERBX_MAX_CALLS_PER_DAY=10
VERBX_MAX_CHARS_PER_CALL=400
VERBX_MAX_CHARS_TOTAL=4000
# Found with: python -m src.verbx_probe
VERBX_TTS_PATH=/v1/tts
